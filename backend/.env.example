# CampusConnect Backend Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ----------------------------------------------------------------------
# Supabase project (Project Settings -> API)
# ----------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role secret key — server-side only, bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----------------------------------------------------------------------
# JWT signing secrets — use long random strings in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ----------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------
PORT=5000
# Set to `production` to suppress stack traces / raw driver errors in API
# responses (they are still logged server-side).
NODE_ENV=development

# ----------------------------------------------------------------------
# CORS allowlist — comma-separated list of exact browser origins allowed to
# call this API. Defaults to http://localhost:3000 (the Vite dev host) when
# unset. Set this to your deployed frontend origin(s) in production; the API
# is NOT open to all origins.
#   e.g. CORS_ORIGIN=https://campusconnect.example.com,https://www.campusconnect.example.com
# ----------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------------------------------
# Rate limiting on the credential endpoints (login / register /
# forgot-password / reset-password). Per IP address.
# ----------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=50
# Set to `true` to switch the limiter off entirely (load testing only).
RATE_LIMIT_DISABLED=false

# ----------------------------------------------------------------------
# QR attendance token signing secret
# ----------------------------------------------------------------------
QR_SECRET=change-me-to-a-long-random-string
