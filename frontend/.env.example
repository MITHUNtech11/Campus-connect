# Base URL of the CampusConnect backend (backend/server/server.cjs).
# Read by src/lib/api.ts at build/dev time. Must be reachable from the BROWSER,
# so use the machine's hostname/IP rather than a container-internal name.
VITE_API_URL="http://localhost:5000"

# Google OAuth Client ID for Google Sign-In button on Login page
VITE_GOOGLE_CLIENT_ID="340198153122-c2pci7brce32hh5mchdm3s222sbm8v1s.apps.googleusercontent.com"

# Port this frontend host process (server.ts) listens on. Optional, default 3000.
# PORT=3000
